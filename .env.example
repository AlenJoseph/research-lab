# Copy to .env and set your keys (never commit .env).

# Semantic Scholar — request at https://www.semanticscholar.org/product/api#api-key-form
# Intro tier: 1 request/second cumulative across all endpoints.
SEMANTIC_SCHOLAR_API_KEY=

# Zotero — create at https://www.zotero.org/settings/keys/new
# Needs library write access for sync.
ZOTERO_API_KEY=

# Optional: pin a specific Zotero collection key instead of auto-creating research-lab/<topic>
# ZOTERO_COLLECTION_KEY=
